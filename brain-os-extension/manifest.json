{
  "manifest_version": 3,
  "name": "Brain Extension",
  "version": "6.0.0",
  "description": "AI-powered Second Brain and Autonomous Web Pilot",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost:5050/*",
    "https://*.youtube.com/*",
    "https://api.github.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brain Extension"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "agent-content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-command-palette": {
      "suggested_key": { "default": "Ctrl+K", "mac": "Command+K" },
      "description": "Open Command Palette"
    },
    "quick-save": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Quick Save Selection"
    },
    "open-sidepanel": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open Side Panel"
    }
  }
}